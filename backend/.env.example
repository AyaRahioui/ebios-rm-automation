# Database (Docker PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:Admin123!@localhost:5432/ebios_rm
DATABASE_URL_SYNC=postgresql://postgres:Admin123!@localhost:5432/ebios_rm

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Email Configuration (for production SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@ebios-rm.com
SMTP_USE_TLS=true

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Application
APP_NAME=EBIOS RM
APP_VERSION=0.1.0
DEBUG=true

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB
